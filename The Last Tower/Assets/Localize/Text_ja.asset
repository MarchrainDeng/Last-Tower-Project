      m_Items: []
  - m_Id: 3022447267696640
    m_Localized: "\"\u30D6\u30ED\u30C3\u30AF\u306F\u53F3\u4E0A\u306B3\u3064\u767B\u5834\u3057\u307E\u3059\u3002\n\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u30D1\u30C3\u30C9\u306E\u5DE6\u53F3\u3067\u30AB\u30FC\u30BD\u30EB\u3092\u79FB\u52D5\u3057\u3066\u3001\u6C7A\u5B9A\u30DC\u30BF\u30F3\u3067\u30D6\u30ED\u30C3\u30AF\u3092\u9078\u629E\u3067\u304D\u307E\u3059\u3002\""
